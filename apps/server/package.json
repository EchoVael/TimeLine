{
  "name": "@timemagic/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@timemagic/shared": "workspace:*",
    "better-sqlite3": "^12.10.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  }
}
