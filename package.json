{
  "name": "timemagic",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "TIMEMAGIC_STARTUP_TOKEN=timemagic-dev concurrently -k -n server,web \"pnpm --filter @timemagic/server dev\" \"pnpm --filter @timemagic/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
